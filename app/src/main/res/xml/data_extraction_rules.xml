<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+ backup/transfer rules — same scope as backup_rules.xml. -->
<data-extraction-rules>
    <cloud-backup>
        <include domain="database" path="." />
        <include domain="file" path="prescriptions/" />
        <include domain="file" path="photos/" />
        <include domain="file" path="documents/" />
        <include domain="file" path="datastore/settings.preferences_pb" />
        <include domain="sharedpref" path="theme_prefs_sync.xml" />
    </cloud-backup>
    <device-transfer>
        <include domain="database" path="." />
        <include domain="file" path="prescriptions/" />
        <include domain="file" path="photos/" />
        <include domain="file" path="documents/" />
        <include domain="file" path="datastore/settings.preferences_pb" />
        <include domain="sharedpref" path="theme_prefs_sync.xml" />
    </device-transfer>
</data-extraction-rules>
